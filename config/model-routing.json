  "tiers": {
    "0": {"name": "DETERMINISTIC", "model": null, "execution": "local Python scripts"},
    "1": {"name": "ROUTINE", "model": "openai/gpt-5.6-luna", "execution": "current authorized/default model"},
    "2": {"name": "QUALITY", "model": "openai/gpt-5.6-sol", "execution": "explicit native OpenClaw subagent"},
    "3": {"name": "DEEP", "model": "openai/gpt-6-astra", "execution": "explicit native OpenClaw subagent"}
